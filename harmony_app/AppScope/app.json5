{
  "app": {
    // bundleName must match the bundle-name recorded in the signing profile
    // used by build_hap.sh (apl=normal).
    "bundleName": "com.huawei.electron",
    "vendor": "huawei",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
