From 952bcfa7f1fcdd34030109d9a42f09e0825a0642 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Mon, 7 Sep 2026 16:21:28 +0800
Subject: [PATCH] disable libuv io_uring on HarmonyOS

HarmonyOS application processes filter io_uring_setup (aarch64 syscall
425) with seccomp, so libuv's runtime probe for the ring does not fail
gracefully -- the kernel raises SIGSYS and the whole app process is
killed as soon as Node's event loop is created.

Take the same route libuv already takes for Android, where the syscall
is likewise present in the kernel but blocked by the sandbox: skip the
probe entirely and stay on the epoll path.
---
 deps/uv/src/unix/linux.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/deps/uv/src/unix/linux.c b/deps/uv/src/unix/linux.c
index ea3e2de0..f4a704b6 100644
--- a/deps/uv/src/unix/linux.c
+++ b/deps/uv/src/unix/linux.c
@@ -456,8 +456,8 @@ int uv__io_uring_register(int fd, unsigned opcode, void* arg, unsigned nargs) {
 
 
 static int uv__use_io_uring(uint32_t flags) {
-#if defined(__ANDROID_API__)
-  return 0;  /* Possibly available but blocked by seccomp. */
+#if defined(__ANDROID_API__) || defined(__OHOS__)
+  return 0;  /* Possibly available but blocked by seccomp (OHOS/Android). */
 #elif defined(__arm__) && __SIZEOF_POINTER__ == 4
   /* See https://github.com/libuv/libuv/issues/4158. */
   return 0;  /* All 32 bits kernels appear buggy. */
