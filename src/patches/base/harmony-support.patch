+#if BUILDFLAG(IS_HARMONY)
+namespace {
+
+// Minimal recursive-descent JSON parser for HarmonyOS bring-up.
+// chromium's C++ JSONParser was removed upstream (replaced by rust
+// serde_json_lenient), and rust is not wired into the harmony toolchain.
+// Supports: object / array / string (incl. \uXXXX) / number / bool / null.
+class MiniJsonParser {
+ public:
+  MiniJsonParser(std::string_view input, size_t max_depth)
+      : p_(input.data()), end_(input.data() + input.size()),
+        max_depth_(max_depth) {}
+
+  std::optional<base::Value> Parse() {
+    SkipWs();
+    auto v = ParseValue(0);
+    if (!v) return std::nullopt;
+    SkipWs();
+    if (p_ != end_) return std::nullopt;  // trailing garbage
+    return v;
+  }
+
+ private:
+  void SkipWs() {
+    while (p_ != end_ && (*p_ == ' ' || *p_ == '\t' || *p_ == '\n' ||
+                          *p_ == '\r')) {
+      ++p_;
+    }
+  }
+
+  bool Consume(char c) {
+    if (p_ != end_ && *p_ == c) {
+      ++p_;
+      return true;
+    }
+    return false;
+  }
+
+  std::optional<base::Value> ParseValue(size_t depth) {
+    if (depth > max_depth_) return std::nullopt;
+    SkipWs();
+    if (p_ == end_) return std::nullopt;
+    switch (*p_) {
+      case '{':
+        return ParseObject(depth);
+      case '[':
+        return ParseArray(depth);
+      case '"': {
+        auto s = ParseString();
+        if (!s) return std::nullopt;
+        return base::Value(std::move(*s));
+      }
+      case 't':
+        if (end_ - p_ >= 4 && strncmp(p_, "true", 4) == 0) {
+          p_ += 4;
+          return base::Value(true);
+        }
+        return std::nullopt;
+      case 'f':
+        if (end_ - p_ >= 5 && strncmp(p_, "false", 5) == 0) {
+          p_ += 5;
+          return base::Value(false);
+        }
+        return std::nullopt;
+      case 'n':
+        if (end_ - p_ >= 4 && strncmp(p_, "null", 4) == 0) {
+          p_ += 4;
+          return base::Value();
+        }
+        return std::nullopt;
+      default:
+        return ParseNumber();
+    }
+  }
+
+  std::optional<base::Value> ParseObject(size_t depth) {
+    if (!Consume('{')) return std::nullopt;
+    base::Value::Dict dict;
+    SkipWs();
+    if (Consume('}')) return base::Value(std::move(dict));
+    while (true) {
+      SkipWs();
+      auto key = ParseString();
+      if (!key) return std::nullopt;
+      SkipWs();
+      if (!Consume(':')) return std::nullopt;
+      auto val = ParseValue(depth + 1);
+      if (!val) return std::nullopt;
+      dict.Set(*key, std::move(*val));
+      SkipWs();
+      if (Consume(',')) continue;
+      if (Consume('}')) return base::Value(std::move(dict));
+      return std::nullopt;
+    }
+  }
+
+  std::optional<base::Value> ParseArray(size_t depth) {
+    if (!Consume('[')) return std::nullopt;
+    base::Value::List list;
+    SkipWs();
+    if (Consume(']')) return base::Value(std::move(list));
+    while (true) {
+      auto val = ParseValue(depth + 1);
+      if (!val) return std::nullopt;
+      list.Append(std::move(*val));
+      SkipWs();
+      if (Consume(',')) continue;
+      if (Consume(']')) return base::Value(std::move(list));
+      return std::nullopt;
+    }
+  }
+
+  std::optional<std::string> ParseString() {
+    if (!Consume('"')) return std::nullopt;
+    std::string out;
+    while (p_ != end_) {
+      unsigned char c = static_cast<unsigned char>(*p_);
+      if (c == '"') {
+        ++p_;
+        return out;
+      }
+      if (c == '\\') {
+        ++p_;
+        if (p_ == end_) return std::nullopt;
+        switch (*p_) {
+          case '"': out += '"'; break;
+          case '\\': out += '\\'; break;
+          case '/': out += '/'; break;
+          case 'b': out += '\b'; break;
+          case 'f': out += '\f'; break;
+          case 'n': out += '\n'; break;
+          case 'r': out += '\r'; break;
+          case 't': out += '\t'; break;
+          case 'u': {
+            if (end_ - p_ < 5) return std::nullopt;
+            unsigned cp = 0;
+            for (int i = 1; i <= 4; i++) {
+              char h = p_[i];
+              cp <<= 4;
+              if (h >= '0' && h <= '9') cp |= h - '0';
+              else if (h >= 'a' && h <= 'f') cp |= h - 'a' + 10;
+              else if (h >= 'A' && h <= 'F') cp |= h - 'A' + 10;
+              else return std::nullopt;
+            }
+            p_ += 4;
+            // UTF-8 encode (surrogate pairs unhandled — asar headers are
+            // plain ASCII; lone surrogates encoded as-is).
+            if (cp < 0x80) {
+              out += static_cast<char>(cp);
+            } else if (cp < 0x800) {
+              out += static_cast<char>(0xC0 | (cp >> 6));
+              out += static_cast<char>(0x80 | (cp & 0x3F));
+            } else {
+              out += static_cast<char>(0xE0 | (cp >> 12));
+              out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+              out += static_cast<char>(0x80 | (cp & 0x3F));
+            }
+            break;
+          }
+          default:
+            return std::nullopt;
+        }
+        ++p_;
+      } else {
+        out += static_cast<char>(c);
+        ++p_;
+      }
+    }
+    return std::nullopt;  // unterminated
+  }
+
+  std::optional<base::Value> ParseNumber() {
+    const char* start = p_;
+    if (p_ != end_ && *p_ == '-') ++p_;
+    while (p_ != end_ && *p_ >= '0' && *p_ <= '9') ++p_;
+    bool is_double = false;
+    if (p_ != end_ && *p_ == '.') {
+      is_double = true;
+      ++p_;
+      while (p_ != end_ && *p_ >= '0' && *p_ <= '9') ++p_;
+    }
+    if (p_ != end_ && (*p_ == 'e' || *p_ == 'E')) {
+      is_double = true;
+      ++p_;
+      if (p_ != end_ && (*p_ == '+' || *p_ == '-')) ++p_;
+      while (p_ != end_ && *p_ >= '0' && *p_ <= '9') ++p_;
+    }
+    if (p_ == start) return std::nullopt;
+    std::string num(start, p_ - start);
+    if (!is_double) {
+      int64_t i64;
+      if (base::StringToInt64(num, &i64)) {
+        if (i64 >= std::numeric_limits<int>::min() &&
+            i64 <= std::numeric_limits<int>::max()) {
+          return base::Value(static_cast<int>(i64));
+        }
+        return base::Value(static_cast<double>(i64));
+      }
+    }
+    double d;
+    if (base::StringToDouble(num, &d)) return base::Value(d);
+    return std::nullopt;
+  }
+
+  const char* p_;
+  const char* end_;
+  const size_t max_depth_;
+};
+
+}  // namespace
