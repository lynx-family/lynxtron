+namespace {
+CefRefPtr<CefRequestContext> webview_request_context;
+}  // namespace
+
+bool InitializeWebviewRequestContext(const cef_extension_settings_t* settings) {
+  if (settings) {
+    // Chrome bootstrap always backs the global context with its initial disk
+    // profile. An explicit context is required for empty-path incognito mode.
+    CefRequestContextSettings context_settings;
+    CefString(&context_settings.cache_path) =
+        settings->cache_path ? settings->cache_path : "";
+    webview_request_context =
+        CefRequestContext::CreateContext(context_settings, nullptr);
+  } else {
+    webview_request_context = CefRequestContext::GetGlobalContext();
+  }
+  return webview_request_context != nullptr;
+}
+
+CefRefPtr<CefRequestContext> GetWebviewRequestContext() {
+  return webview_request_context ? webview_request_context
+                                 : CefRequestContext::GetGlobalContext();
+}
