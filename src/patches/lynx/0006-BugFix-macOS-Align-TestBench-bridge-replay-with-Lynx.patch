+bool IsEquivalentBridgeDiscriminator(const std::string& current,
+                                     const std::string& recorded) {
+  if (current == recorded) {
+    return true;
+  }
+  const auto current_path = current.find(kStarlingRequestPath);
+  const auto recorded_path = recorded.find(kStarlingRequestPath);
+  return current_path != std::string::npos &&
+         recorded_path != std::string::npos &&
+         current.substr(current_path) == recorded.substr(recorded_path);
+}
