   return true;
 }
 
+bool ModuleTestBench::isSameBridgeCallMethod(const MethodMetadata &method,
+                                             Runtime *rt, const Value *args,
+                                             size_t count,
+                                             rapidjson::Value &value) {
+  if (name_ != "bridge" || method.name != "call" || count == 0 ||
+      !args[0].isString() || !value.HasMember("Method Name") ||
+      !value["Method Name"].IsString() ||
+      value["Method Name"].GetString() != method.name ||
+      !value.HasMember("Params") || !value["Params"].IsObject()) {
+    return false;
+  }
+
+  const auto &params = value["Params"];
+  if (!params.HasMember("args") || !params["args"].IsArray() ||
+      params["args"].Empty() || !params["args"][0].IsString() ||
+      args[0].getString(*rt).utf8(*rt) != params["args"][0].GetString()) {
+    return false;
+  }
+
+  const std::string recorded_discriminator =
+      GetRecordedBridgeCallDiscriminator(value);
+  return recorded_discriminator.empty() ||
+         IsEquivalentBridgeDiscriminator(
+             GetBridgeCallDiscriminator(rt, args, count),
+             recorded_discriminator);
+}
+
+std::string ModuleTestBench::GetBridgeCallName(Runtime *rt, const Value *args,
+                                               size_t count) {
+  if (count == 0 || !args || !args[0].isString()) {
+    return "";
+  }
+  return args[0].getString(*rt).utf8(*rt);
+}
+
+std::string ModuleTestBench::GetBridgeCallDiscriminator(Runtime *rt,
+                                                        const Value *args,
+                                                        size_t count) {
+  if (count < 2 || !args || !args[1].isObject()) {
+    return "";
+  }
+  auto params = args[1].getObject(*rt);
+  auto data_value = params.getProperty(*rt, "data");
+  if (!data_value || !data_value->isObject()) {
+    return "";
+  }
+  auto data = data_value->getObject(*rt);
+  static constexpr const char *kDiscriminatorKeys[] = {"url", "key",
+                                                       "eventName", "name"};
+  for (const char *key : kDiscriminatorKeys) {
+    auto value = data.getProperty(*rt, key);
+    if (value && value->isString()) {
+      return value->getString(*rt).utf8(*rt);
+    }
+  }
+  return "";
+}
+
+std::string ModuleTestBench::GetRecordedBridgeCallDiscriminator(
+    rapidjson::Value &value) {
+  if (!value.HasMember("Params") || !value["Params"].IsObject()) {
+    return "";
+  }
+  const auto &params = value["Params"];
+  if (!params.HasMember("args") || !params["args"].IsArray() ||
+      params["args"].Size() < 2 || !params["args"][1].IsObject()) {
+    return "";
+  }
+  const auto &bridge_params = params["args"][1];
+  if (!bridge_params.HasMember("data") ||
+      !bridge_params["data"].IsObject()) {
+    return "";
+  }
+  const auto &data = bridge_params["data"];
+  static constexpr const char *kDiscriminatorKeys[] = {"url", "key",
+                                                       "eventName", "name"};
+  for (const char *key : kDiscriminatorKeys) {
+    if (data.HasMember(key) && data[key].IsString()) {
+      return data[key].GetString();
+    }
+  }
+  return "";
+}
+
+std::string ModuleTestBench::BuildBridgeReplayKey(
+    const MethodMetadata &method, Runtime *rt, const Value *args,
+    size_t count) {
+  const std::string call_name = GetBridgeCallName(rt, args, count);
+  if (call_name.empty()) {
+    return "";
+  }
+  std::string key = method.name + "\n" + call_name;
+  const std::string discriminator =
+      GetBridgeCallDiscriminator(rt, args, count);
+  if (!discriminator.empty()) {
+    key += "\n" + discriminator;
+  }
+  return key;
+}
+
+void ModuleTestBench::CollectTopLevelCallbackFunctions(Runtime *rt,
+                                                       const Value *args,
+                                                       size_t count) {
+  for (size_t index = 0; index < count; ++index) {
+    const auto &arg = args[index];
+    if (arg.isObject() && arg.getObject(*rt).isFunction(*rt)) {
+      callbackFunctions.push_back(arg.getObject(*rt).getFunction(*rt));
+    }
+  }
+}
