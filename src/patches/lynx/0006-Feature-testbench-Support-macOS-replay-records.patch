+
+void JsonToNapi(napi_env env, const rapidjson::Value& json,
+                napi_value* result) {
+  if (json.IsNull()) {
+    napi_get_null(env, result);
+    return;
+  }
+  if (json.IsBool()) {
+    napi_get_boolean(env, json.GetBool(), result);
+    return;
+  }
+  if (json.IsInt64()) {
+    napi_create_int64(env, json.GetInt64(), result);
+    return;
+  }
+  if (json.IsUint64()) {
+    napi_create_double(env, static_cast<double>(json.GetUint64()), result);
+    return;
+  }
+  if (json.IsNumber()) {
+    napi_create_double(env, json.GetDouble(), result);
+    return;
+  }
+  if (json.IsString()) {
+    napi_create_string_utf8(env, json.GetString(), json.GetStringLength(),
+                            result);
+    return;
+  }
+  if (json.IsArray()) {
+    napi_create_array_with_length(env, json.Size(), result);
+    for (rapidjson::SizeType i = 0; i < json.Size(); ++i) {
+      napi_value item = nullptr;
+      JsonToNapi(env, json[i], &item);
+      napi_set_element(env, *result, i, item);
+    }
+    return;
+  }
+  if (json.IsObject()) {
+    napi_create_object(env, result);
+    for (auto it = json.MemberBegin(); it != json.MemberEnd(); ++it) {
+      napi_value value = nullptr;
+      JsonToNapi(env, it->value, &value);
+      std::string key(it->name.GetString(), it->name.GetStringLength());
+      napi_set_named_property(env, *result, key.c_str(), value);
+    }
+    return;
+  }
+  napi_get_undefined(env, result);
+}
