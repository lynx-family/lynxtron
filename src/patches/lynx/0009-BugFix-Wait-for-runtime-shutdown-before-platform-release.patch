 #include "core/runtime/js/jsi/v8/v8_platform_data.h"

+#include <mutex>
+#include <utility>
+
+#include "base/include/log/logging.h"
+#include "base/include/no_destructor.h"
+
 namespace lynx {
 namespace runtime {
 namespace js {
+namespace {
+struct PlatformState {
+  std::mutex mutex;
+  void* platform = nullptr;
+  size_t isolates = 0;
+  bool shutting_down = false;
+  base::closure completion;
+};
+
+PlatformState& GetState() {
+  static base::NoDestructor<PlatformState> state;
+  return *state;
+}
+}  // namespace
+
+void V8PlatformData::SetV8Platform(void* platform) {
+  auto& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  state.platform = platform;
+}
+
+void* V8PlatformData::GetV8Platform() {
+  auto& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  return state.platform;
+}

-static void* v8_platform_ = nullptr;
+bool V8PlatformData::TryRegisterIsolate() {
+  auto& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.shutting_down) {
+    return false;
+  }
+  ++state.isolates;
+  return true;
+}

-void V8PlatformData::SetV8Platform(void* platform) { v8_platform_ = platform; }
+void V8PlatformData::IsolateFinished() {
+  auto& state = GetState();
+  base::closure completion;
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    CHECK(state.isolates > 0);
+    if (--state.isolates == 0 && state.shutting_down) {
+      completion = std::move(state.completion);
+    }
+  }
+  if (completion) {
+    LOGI("Lynx Node isolates shutdown complete");
+    completion();
+  }
+}

-void* V8PlatformData::GetV8Platform() { return v8_platform_; }
+void V8PlatformData::Shutdown(base::closure completion) {
+  auto& state = GetState();
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    CHECK(!state.shutting_down);
+    state.shutting_down = true;
+    LOGI("Lynx Node isolates shutdown begin, pending:" << state.isolates);
+    if (state.isolates != 0) {
+      state.completion = std::move(completion);
+      return;
+    }
+  }
+  completion();
+}

 }  // namespace js
 }  // namespace runtime
