+struct RuntimeShutdownState {
+  struct JSLoop {
+    fml::RefPtr<fml::TaskRunner> runner;
+    std::vector<std::weak_ptr<LynxActor<BTSRuntime>>> actors;
+  };
+  std::mutex mutex;
+  bool shutting_down = false;
+  std::unordered_map<fml::MessageLoopImpl*, JSLoop> loops;
+};
+
+RuntimeShutdownState& GetRuntimeShutdownState() {
+  static base::NoDestructor<RuntimeShutdownState> state;
+  return *state;
+}
+
 bool DoAsyncHydration(base::ThreadStrategyForRendering strategy,
                       const ShellOption& option) {
   return !base::IsEngineAsync(strategy) &&
@@ -116,6 +133,55 @@ void InvokePlatformCallbackAndRemove(

 }  // namespace

+void LynxShell::RegisterRuntimeForShutdown(
+    const std::shared_ptr<LynxActor<BTSRuntime>>& actor) {
+  auto& state = GetRuntimeShutdownState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  CHECK(!state.shutting_down);
+  auto runner = actor->GetRunner();
+  auto& loop = state.loops[runner->GetLoop().get()];
+  loop.runner = std::move(runner);
+  auto& actors = loop.actors;
+  actors.erase(
+      std::remove_if(actors.begin(), actors.end(),
+                     [](const auto& actor) { return actor.expired(); }),
+      actors.end());
+  actors.push_back(actor);
+}
+
+void LynxShell::ShutdownRuntimes(base::closure completion) {
+  auto& state = GetRuntimeShutdownState();
+  decltype(state.loops) loops;
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    CHECK(!state.shutting_down);
+    state.shutting_down = true;
+    loops = std::move(state.loops);
+  }
+  if (loops.empty()) {
+    completion();
+    return;
+  }
+  auto pending = std::make_shared<std::atomic<size_t>>(loops.size());
+  auto done = std::make_shared<base::closure>(std::move(completion));
+  for (auto& [id, loop] : loops) {
+    loop.runner->PostTask(
+        [actors = std::move(loop.actors), pending, done]() {
+          for (const auto& weak_actor : actors) {
+            if (auto actor = weak_actor.lock()) {
+              actor->Act([](auto& runtime) { runtime.reset(); });
+            }
+          }
+          // Keep used loops even after their last page closes: their
+          // thread-local realm managers can still own a shared VM.
+          runtime::JSRealmManager::Instance()->Shutdown();
+          if (pending->fetch_sub(1) == 1) {
+            (*done)();
+          }
+        });
+  }
+}
