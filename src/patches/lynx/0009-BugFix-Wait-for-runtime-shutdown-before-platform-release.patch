diff --git a/core/shell/runtime/runtime_shutdown.cc b/core/shell/runtime/runtime_shutdown.cc
new file mode 100644
--- /dev/null
+++ b/core/shell/runtime/runtime_shutdown.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+#include "core/shell/runtime/runtime_shutdown.h"
+
+#include <atomic>
+#include <utility>
+#include <vector>
+
+#include "base/include/log/logging.h"
+#include "core/runtime/js/js_realm_manager.h"
+#include "core/shell/runtime/bts/bts_runtime.h"
+
+namespace lynx {
+namespace shell {
+
+RuntimeShutdown& RuntimeShutdown::Instance() {
+  static base::NoDestructor<RuntimeShutdown> instance;
+  return *instance;
+}
+
+void RuntimeShutdown::Register(
+    const std::shared_ptr<LynxActor<BTSRuntime>>& actor) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  CHECK(!shutting_down_);
+  auto runner = actor->GetRunner();
+  actors_[actor->Impl()] = {actor, runner};
+  runners_.emplace(runner->GetLoop().get(), std::move(runner));
+}
+
+void RuntimeShutdown::Unregister(BTSRuntime* runtime) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  actors_.erase(runtime);
+}
+
+void RuntimeShutdown::Shutdown(base::closure completion) {
+  using Actors = std::vector<std::weak_ptr<LynxActor<BTSRuntime>>>;
+  std::unordered_map<fml::MessageLoopImpl*, Actors> actors_by_loop;
+  decltype(runners_) runners;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    CHECK(!shutting_down_);
+    shutting_down_ = true;
+    for (const auto& [runtime, registration] : actors_) {
+      actors_by_loop[registration.runner->GetLoop().get()].push_back(
+          registration.actor);
+    }
+    runners = runners_;
+  }
+
+  LOGI("Runtime shutdown begin, JS loops:" << runners.size());
+  if (runners.empty()) {
+    completion();
+    return;
+  }
+  auto pending = std::make_shared<std::atomic<size_t>>(runners.size());
+  auto done = std::make_shared<base::closure>(std::move(completion));
+  for (const auto& [loop, runner] : runners) {
+    runner->PostTask(
+        [actors = std::move(actors_by_loop[loop]), pending, done]() mutable {
+          // Runs behind previously enqueued initialization and destruction
+          // tasks. Destroy through the actor so later queued messages see a
+          // null runtime.
+          for (const auto& weak_actor : actors) {
+            if (auto actor = weak_actor.lock()) {
+              actor->Act([](auto& runtime) { runtime.reset(); });
+            }
+          }
+          runtime::JSRealmManager::Instance()->Shutdown();
+          if (pending->fetch_sub(1) == 1) {
+            LOGI("Runtime shutdown complete");
+            (*done)();
+          }
+        });
+  }
+}
+
+}  // namespace shell
+}  // namespace lynx
diff --git a/core/shell/runtime/runtime_shutdown.h b/core/shell/runtime/runtime_shutdown.h
new file mode 100644
--- /dev/null
+++ b/core/shell/runtime/runtime_shutdown.h
@@ -0,0 +1,50 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+#ifndef CORE_SHELL_RUNTIME_RUNTIME_SHUTDOWN_H_
+#define CORE_SHELL_RUNTIME_RUNTIME_SHUTDOWN_H_
+
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+#include "base/include/closure.h"
+#include "base/include/lynx_actor.h"
+#include "base/include/no_destructor.h"
+
+namespace lynx {
+namespace shell {
+
+class BTSRuntime;
+
+// Coordinates terminal embedder shutdown without blocking the UI or JS loops.
+class RuntimeShutdown {
+ public:
+  static RuntimeShutdown& Instance();
+
+  void Register(const std::shared_ptr<LynxActor<BTSRuntime>>& actor);
+  void Unregister(BTSRuntime* runtime);
+  void Shutdown(base::closure completion);
+
+ private:
+  friend class base::NoDestructor<RuntimeShutdown>;
+  RuntimeShutdown() = default;
+
+  std::mutex mutex_;
+  bool shutting_down_ = false;
+  struct Registration {
+    std::weak_ptr<LynxActor<BTSRuntime>> actor;
+    fml::RefPtr<fml::TaskRunner> runner;
+  };
+  std::unordered_map<BTSRuntime*, Registration> actors_;
+  // Keep every used loop, including loops whose last page has already closed:
+  // their thread-local realm managers can still own a shared VM.
+  std::unordered_map<fml::MessageLoopImpl*, fml::RefPtr<fml::TaskRunner>>
+      runners_;
+};
+
+}  // namespace shell
+}  // namespace lynx
+
+#endif  // CORE_SHELL_RUNTIME_RUNTIME_SHUTDOWN_H_
