 #endif
 }

-JSRealmManager::~JSRealmManager() {
+JSRealmManager::~JSRealmManager() { Shutdown(); }
+
+void JSRealmManager::Shutdown() {
   for (const auto& [type, vm] : mVMContainer_) {
     if (type == runtime::js::JSRuntimeType::v8) {
       UnregisterVMInstance(vm.get());
     }
   }
+  // Remove entries before destroying realms: release callbacks may look them up.
+  auto shared_contexts = std::move(shared_context_map_);
+  auto shared_groups = std::move(new_share_group_map_);
+  shared_contexts.clear();
+  shared_groups.clear();
   // Should destroy js_realm_manager_delegate_ before mVMContainer_
   js_realm_manager_delegate_.reset();
+  mVMContainer_.clear();
+  weak_runtimes_.clear();
 }

 bool JSRealmManager::IsSingleJSContext(const std::string& group_id) {
