+// Terminal asynchronous shutdown. No new views or background runtimes may be
+// created after this call. Keep the host UI loop and JS loops running until the
+// callback is invoked (possibly on a JS thread). Call exactly once, before
+// destroying the shared Node/V8 platform.
+typedef void (*lynx_env_shutdown_callback)(void* user_data);
+LYNX_CAPI_EXPORT void lynx_env_shutdown_runtimes(
+    lynx_env_shutdown_callback callback, void* user_data);
