From 59608a9fbc55b1c44cc2be5ddb068d8b8368d775 Mon Sep 17 00:00:00 2001
From: "chenyouhui.duke" <scripts@lynxtron>
Date: Thu, 30 Jul 2026 19:57:50 +0800
Subject: [PATCH] Revert [BugFix][Desktop] Fix deadlock of vsync for macos

---
 .../macos/common/vsync_monitor_macos.mm       | 39 +++++++++++--------
 1 file changed, 23 insertions(+), 16 deletions(-)

diff --git a/platform/darwin/macos/common/vsync_monitor_macos.mm b/platform/darwin/macos/common/vsync_monitor_macos.mm
index cb459e5c01..595b4b9abe 100644
--- a/platform/darwin/macos/common/vsync_monitor_macos.mm
+++ b/platform/darwin/macos/common/vsync_monitor_macos.mm
@@ -59,5 +59,23 @@ using VSyncCallback = std::function<void(fml::TimePoint, fml::TimePoint)>;
 namespace lynx {
 namespace base {
 
+template <typename Block>
+void ExecuteOnMainThreadAsync(Block block) {
+  if ([NSThread isMainThread]) {
+    block();
+  } else {
+    dispatch_async(dispatch_get_main_queue(), block);
+  }
+}
+
+template <typename Block>
+void ExecuteOnMainThreadSync(Block block) {
+  if ([NSThread isMainThread]) {
+    block();
+  } else {
+    dispatch_sync(dispatch_get_main_queue(), block);
+  }
+}
+
 VSyncMonitorMacOS::VSyncMonitorMacOS()
     : VSyncMonitorFallback(fml::TimeDelta::FromSecondsF(1.0 / 60)) {}
@@ -72,11 +90,7 @@ void VSyncMonitorMacOS::Init() {
   std::weak_ptr<VSyncMonitorMacOS> weak_this =
       std::static_pointer_cast<VSyncMonitorMacOS>(shared_from_this());
 
-  if (!runner_) {
-    return;
-  }
-
-  fml::TaskRunner::RunNowOrPostTask(runner_, ^{
+  ExecuteOnMainThreadSync(^{
     impl_ = [[DisplayLinkImpl alloc]
         initWith:[weak_this](fml::TimePoint start_time, fml::TimePoint target_time) {
           if (auto vsync_monitor = weak_this.lock()) {
@@ -92,14 +106,7 @@ VSyncMonitorMacOS::~VSyncMonitorMacOS() {
 
   auto impl = impl_;
   impl_ = nil;
-  if (!runner_) {
-    if (impl) {
-      [impl destroy];
-    }
-    return;
-  }
-
-  fml::TaskRunner::RunNowOrPostTask(runner_, ^{
+  ExecuteOnMainThreadAsync(^{
     if (impl) {
       [impl destroy];
     }
@@ -107,15 +114,15 @@ VSyncMonitorMacOS::~VSyncMonitorMacOS() {
 }
 
 void VSyncMonitorMacOS::RequestVSync() {
-  if (destroying_.load() || !runner_) {
+  if (destroying_.load()) {
     return;
   }
-  if (!runner_->GetLoop()) {
+  if (runner_ && !runner_->GetLoop()) {
     VSyncMonitorFallback::RequestVSync();
     return;
   }
   auto impl = impl_;
-  fml::TaskRunner::RunNowOrPostTask(runner_, ^{
+  ExecuteOnMainThreadAsync(^{
     if (impl) {
       impl.displayLink.paused = NO;
     }
-- 
2.49.0
