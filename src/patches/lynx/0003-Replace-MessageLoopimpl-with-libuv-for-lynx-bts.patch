diff --git a/base/src/fml/platform/node/message_loop_node.cc b/base/src/fml/platform/node/message_loop_node.cc
new file mode 100644
index 00000000..d166f648
--- /dev/null
+++ b/base/src/fml/platform/node/message_loop_node.cc
@@ -0,0 +1,109 @@
+// Copyright 2025 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+#include "base/include/fml/platform/node/message_loop_node.h"
+
+namespace lynx {
+namespace fml {
+
+MessageLoopNode::MessageLoopNode() {
+  [[maybe_unused]] int r = uv_loop_init(&uv_loop_);
+  LYNX_BASE_CHECK(r == 0);
+
+  [[maybe_unused]] int timer_init = uv_timer_init(&uv_loop_, &timer_);
+  LYNX_BASE_CHECK(timer_init == 0);
+  timer_.data = this;
+
+  [[maybe_unused]] int async_init =
+      uv_async_init(&uv_loop_, &async_, [](uv_async_t* h) {
+        auto* self = static_cast<MessageLoopNode*>(h->data);
+        self->OnWakeUp();
+      });
+  async_.data = this;
+
+  LYNX_BASE_CHECK(async_init == 0);
+}
+
+MessageLoopNode::~MessageLoopNode() {
+  if (running_) {
+    Terminate();
+  }
+
+  uv_walk(
+      &uv_loop_,
+      [](uv_handle_t* h, void*) {
+        if (!uv_is_closing(h)) {
+          uv_close(h, nullptr);
+        }
+      },
+      nullptr);
+
+  uv_run(&uv_loop_, UV_RUN_NOWAIT);
+  uv_loop_close(&uv_loop_);
+}
+
+void MessageLoopNode::Run() {
+  running_ = true;
+  while (running_) {
+    // Node environment cleanup may run this uv loop. Keep Lynx tasks outside
+    // the uv_run callback stack so cleanup cannot re-enter another Lynx task.
+    if (event_fired_) {
+      event_fired_ = false;
+      RunExpiredTasksNow();
+      continue;
+    }
+    uv_run(&uv_loop_, UV_RUN_ONCE);
+  }
+  running_ = false;
+}
+
+void MessageLoopNode::Terminate() {
+  running_ = false;
+
+  int stop_res = uv_timer_stop(&timer_);
+  uv_close(reinterpret_cast<uv_handle_t*>(&timer_), nullptr);
+  uv_close(reinterpret_cast<uv_handle_t*>(&async_), nullptr);
+  uv_run(&uv_loop_, UV_RUN_NOWAIT);
+
+  uv_stop(&uv_loop_);
+}
+
+void MessageLoopNode::WakeUp(fml::TimePoint time_point) {
+  {
+    std::lock_guard<std::mutex> lock(wake_up_mutex_);
+    wake_up_time_ = time_point;
+  }
+  [[maybe_unused]] int send_res = uv_async_send(&async_);
+  LYNX_BASE_CHECK(send_res == 0);
+}
+
+void MessageLoopNode::OnWakeUp() {
+  fml::TimePoint time_point;
+  {
+    std::lock_guard<std::mutex> lock(wake_up_mutex_);
+    time_point = wake_up_time_;
+  }
+
+  auto now = fml::TimePoint::Now();
+  if (now >= time_point) {
+    [[maybe_unused]] int stop_res = uv_timer_stop(&timer_);
+    LYNX_BASE_CHECK(stop_res == 0);
+    OnEventFired();
+    return;
+  }
+
+  int start_res = uv_timer_start(
+      &timer_,
+      [](uv_timer_t* handle) {
+        auto* self = reinterpret_cast<MessageLoopNode*>(handle->data);
+        self->OnEventFired();
+      },
+      (time_point - now).ToMilliseconds(), 0);
+  LYNX_BASE_CHECK(start_res == 0);
+}
+
+void MessageLoopNode::OnEventFired() { event_fired_ = true; }
+
+}  // namespace fml
+}  // namespace lynx
