From 2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c Mon Sep 17 00:00:00 2001
From: lynxtron <lynxtron@lynxjs.com>
Date: Mon, 22 Sep 2026 00:00:00 +0800
Subject: [PATCH] Fix desktop_image build failure with pinned skity codec API

The open-source build pins skity at a revision whose skity::Codec only
exposes Decode() and has no DecodeOptions struct / Decode(DecodeOptions)
overload. The desktop codec used the newer decode-time scaling API, which
fails to compile:

  error: no member named 'DecodeOptions' in namespace 'skity'

Decode at the intrinsic size instead. DesktopImage::ToBitmap() scales the
decoded pixmap to the requested render size, so the visible output is
unchanged; only the decode-time downscaling optimization is dropped.

The Skity codec calls now live in skity_image_codec.cc after the desktop
image codec refactor.
---
 .../platform/common/desktop/codec/skity_image_codec.cc    | 15 ++-------------
 1 file changed, 2 insertions(+), 13 deletions(-)

diff --git a/clay/shell/platform/common/desktop/codec/skity_image_codec.cc b/clay/shell/platform/common/desktop/codec/skity_image_codec.cc
index 7d889ec9..34d2a01e 100644
--- a/clay/shell/platform/common/desktop/codec/skity_image_codec.cc
+++ b/clay/shell/platform/common/desktop/codec/skity_image_codec.cc
@@ -51,17 +51,6 @@ FrameInfo MakeFrameInfo(std::shared_ptr<skity::Pixmap> pixmap, int duration) {
   return {MakeGraphicsImage(std::move(pixmap)), duration};
 }

-std::shared_ptr<skity::Pixmap> DecodeInitialPixmap(
-    const std::shared_ptr<skity::Codec>& codec, const Size& decode_size,
-    bool is_animated) {
-  if (is_animated || decode_size.IsZero()) {
-    return codec->Decode();
-  }
-  auto pixmap = codec->Decode(
-      skity::DecodeOptions{decode_size.width(), decode_size.height()});
-  return pixmap ? pixmap : codec->Decode();
-}
-
 }  // namespace

 class SkityImageCodec::State {
@@ -105,7 +94,7 @@ class SkityImageCodec::State {
 };

 std::shared_ptr<ImageCodecGenerator> SkityImageCodecGenerator::Create(
-    std::shared_ptr<skity::Data> encoded_data, const Size& decode_size) {
+    std::shared_ptr<skity::Data> encoded_data, const Size&) {
   if (!encoded_data || encoded_data->IsEmpty()) {
     return nullptr;
   }
@@ -119,7 +108,7 @@ std::shared_ptr<ImageCodecGenerator> SkityImageCodecGenerator::Create(
       multi_frame_decoder ? multi_frame_decoder->GetFrameCount() : 0;
   const bool is_animated = decoded_frame_count > 1;

-  auto current_pixmap = DecodeInitialPixmap(codec, decode_size, is_animated);
+  auto current_pixmap = codec->Decode();
   if (!IsValidPixmap(current_pixmap)) {
     return nullptr;
   }
