From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lynxtron <lynxtron@lynxjs.com>
Date: Fri, 17 Jul 2026 12:20:00 +0800
Subject: [PATCH] Expose resolved write direction

The updated Lynx text adapter queries the paragraph's resolved direction.
ParagraphImpl already implements this method; expose it through Paragraph's
public interface as in the latest public Textra source.

---
 public/textra/paragraph.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/public/textra/paragraph.h b/public/textra/paragraph.h
index c6a9fc5..0201a3b 100644
--- a/public/textra/paragraph.h
+++ b/public/textra/paragraph.h
@@ -73,6 +73,7 @@ class L_EXPORT Paragraph {
    * @param style A Style object to store the query result
    */
   virtual void QueryStyle(uint32_t char_idx, Style* style) = 0;
+  virtual WriteDirection GetResolvedWriteDirection() const = 0;
 
  public:
   static std::unique_ptr<Paragraph> Create();
-- 
