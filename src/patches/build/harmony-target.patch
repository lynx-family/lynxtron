From f5c028182cd4f98d017fbb7022391cc44874d426 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Mon, 7 Sep 2026 19:23:25 +0800
Subject: [PATCH] Add HarmonyOS target and toolchain to build

Introduces the OHOS build target for the chromium build system:

  - build_config.h: define OS_HARMONY from the NDK clang's __OHOS__, as a
    sibling of OS_LINUX (same kernel, musl libc, ohos uapi).
  - BUILDCONFIG.gn: add is_harmony and the harmony toolchain selection.
  - config/harmony/: the OHOS sysroot, NDK and ABI configuration.
  - toolchain/harmony/: the NDK clang toolchain definitions.
  - clang / compiler / rust / sysroot gni: keep host-only flags, the rust
    toolchain and the chromium sysroot out of the OHOS target graph.
---
 build_config.h                     |  11 ++
 config/BUILDCONFIG.gn              |   2 +
 config/clang/BUILD.gn              |  23 ++-
 config/compiler/BUILD.gn           |  16 ++-
 config/harmony/BUILD.gn            |  26 ++++
 config/harmony/config.gni          | 123 ++++++++++++++++
 config/harmony/get_sdk_ndk_path.py |  31 +++++
 config/rust.gni                    |   2 +-
 config/sysroot.gni                 |   3 +
 toolchain/harmony/BUILD.gn         | 216 +++++++++++++++++++++++++++++
 toolchain/sccache.gni              |   7 +
 11 files changed, 451 insertions(+), 9 deletions(-)
 create mode 100644 config/harmony/BUILD.gn
 create mode 100644 config/harmony/config.gni
 create mode 100644 config/harmony/get_sdk_ndk_path.py
 create mode 100644 toolchain/harmony/BUILD.gn
 create mode 100644 toolchain/sccache.gni

diff --git a/build_config.h b/build_config.h
index 38bc688..a781089 100644
--- a/build_config.h
+++ b/build_config.h
@@ -94,6 +94,11 @@
 // The OS_CHROMEOS macro is defined in GN.
 #define OS_LINUX 1
 #endif  // !defined(OS_CHROMEOS)
+// OpenHarmony NDK clang advertises __OHOS__ as a kernel-level OS marker.
+// Treat it as a sibling of OS_LINUX (same kernel, musl libc, ohos uapi).
+#if defined(__OHOS__)
+#define OS_HARMONY 1
+#endif
 // Include a system header to pull in features.h for glibc/uclibc macros.
 #include <assert.h>
 #if defined(__GLIBC__) && !defined(__UCLIBC__)
@@ -159,6 +164,12 @@
 #define BUILDFLAG_INTERNAL_IS_ANDROID() (0)
 #endif
 
+#if defined(OS_HARMONY)
+#define BUILDFLAG_INTERNAL_IS_HARMONY() (1)
+#else
+#define BUILDFLAG_INTERNAL_IS_HARMONY() (0)
+#endif
+
 #if defined(OS_APPLE)
 #define BUILDFLAG_INTERNAL_IS_APPLE() (1)
 #else
