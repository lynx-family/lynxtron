{
  "name": "@lynx-js/lynxtron",
  "version": "0.0.18",
  "description": "lynxtron npm package test",
  "type": "module",
  "types": "./apis/lynxtron.d.ts",
  "main": "lynxtron.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynxtron.git"
  },
  "bin": {
    "lynxtron": "cli.js",
    "lynxtron-fuses": "fuses-cli.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test \"*.test.js\""
  },
  "dependencies": {
    "node-fetch": "3.3.2",
    "proper-lockfile": "4.1.2",
    "zip-lib": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "yazl": "3.3.1"
  },
  "author": "",
  "license": "ISC",
  "keywords": [
    "lynxtron"
  ],
  "files": [
    "apis",
    "utils",
    "cli.js",
    "fuses.js",
    "fuses-cli.js",
    "install.js",
    "install-policy.js",
    "runtime-artifacts.cjs",
    "runtime-manager.js",
    "native-paths.cjs",
    "lynx.js",
    "lynxtron.js",
    "lynxtron_bin.js",
    "web-host",
    "web-worker.js",
    "context-bridge.js",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./apis/lynxtron.d.ts",
      "default": "./lynxtron.js"
    },
    "./lynx": {
      "types": "./apis/lynx.d.ts",
      "default": "./lynx.js"
    },
    "./fuses": "./fuses.js",
    "./native-paths": "./native-paths.cjs",
    "./runtime-artifacts": "./runtime-artifacts.cjs",
    "./package.json": "./package.json",
    "./context-bridge": {
      "types": "./apis/api/context-bridge.d.ts",
      "browser": "./web-worker.js",
      "default": "./context-bridge.js"
    },
    "./web-host": {
      "types": "./apis/web-host.d.ts",
      "default": "./web-host/index.js"
    },
    "./web-worker": "./web-worker.js"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
