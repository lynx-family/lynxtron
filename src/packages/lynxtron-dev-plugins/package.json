{
  "name": "@lynx-js/lynxtron-dev-plugins",
  "version": "0.0.0-alpha.8",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynxtron.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "bin/",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "exports": {
    "./rspeedy": {
      "types": "./dist/rspeedy.d.ts",
      "default": "./dist/rspeedy.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.ts",
      "default": "./dist/rsbuild.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    }
  },
  "bin": {
    "dev-ready-rspeedy": "bin/cli-rspeedy.js"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.1.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
